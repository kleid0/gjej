# Database (Neon PostgreSQL)
POSTGRES_URL=postgresql://user:password@host:5432/dbname
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/dbname

# Cron job authentication secret
CRON_SECRET=your-secret-here

# Email notifications (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Recipient for admin-only notifications (e.g. weekly pcstore.al health probe).
ADMIN_EMAIL=admin@example.com

# Public site URL (used in sitemap, OG tags, emails)
NEXT_PUBLIC_SITE_URL=https://gjej.al

# Logging verbosity (levels: debug < info < warn < error). Both default to
# "debug" — the most verbose ("super chatty"). Set to info|warn|error to quieten.
#   LOG_LEVEL          → console output (Vercel runtime logs, read via dashboard/MCP)
#   LOG_PERSIST_LEVEL  → durable git log committed to data/logs/events.ndjson
#                        (rides the cron's chore(data): commit; capped + rotated)
LOG_LEVEL=debug
LOG_PERSIST_LEVEL=debug
